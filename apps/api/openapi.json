{
  "openapi": "3.0.3",
  "info": {
    "title": "web-checkout API",
    "description": "Self-service checkout for a snack bar. Staff endpoints need the X-Staff-Key header.",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/menu": {
      "get": {
        "summary": "The Menu, grouped by Category, with live Availability",
        "tags": [
          "kiosk"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "categories"
                  ],
                  "properties": {
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "products"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          },
                          "products": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "id",
                                "name",
                                "emoji",
                                "priceCents",
                                "availability",
                                "maxQuantity"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "format": "uuid"
                                },
                                "name": {
                                  "type": "string"
                                },
                                "emoji": {
                                  "type": "string"
                                },
                                "priceCents": {
                                  "type": "integer"
                                },
                                "availability": {
                                  "type": "string",
                                  "enum": [
                                    "AVAILABLE",
                                    "LAST_UNITS",
                                    "SOLD_OUT"
                                  ]
                                },
                                "maxQuantity": {
                                  "type": "integer",
                                  "description": "Most units of this Product a single Order can take right now"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/checkouts/{id}/payment": {
      "post": {
        "summary": "Pay a Checkout by card, or choose Pay at Pickup; either way an Order is placed on success",
        "tags": [
          "kiosk"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "method"
                ],
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "type": "string",
                    "enum": [
                      "CARD",
                      "PAY_AT_PICKUP"
                    ]
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "description": "A UUID v4, reused when repeating the same request"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "header",
            "name": "x-kiosk-id",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "header",
            "name": "x-force-error",
            "required": false,
            "description": "Demo only, ignored in production: forces a payment outcome"
          }
        ],
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "orderId",
                    "code",
                    "status",
                    "paymentMethod",
                    "totalCents",
                    "cardChargeUnconfirmed",
                    "createdAt",
                    "items"
                  ],
                  "properties": {
                    "orderId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "code": {
                      "type": "string",
                      "description": "Short code the Customer reads out at pickup, such as A-042"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "PAYMENT_PENDING",
                        "PAID",
                        "PICKED_UP",
                        "CANCELLED"
                      ]
                    },
                    "paymentMethod": {
                      "type": "string",
                      "enum": [
                        "CARD",
                        "PAY_AT_PICKUP"
                      ]
                    },
                    "totalCents": {
                      "type": "integer"
                    },
                    "cardChargeUnconfirmed": {
                      "type": "boolean",
                      "description": "A card charge for this purchase could not be confirmed and is being refunded"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "productId",
                          "name",
                          "emoji",
                          "quantity",
                          "unitPriceCents"
                        ],
                        "properties": {
                          "productId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          },
                          "emoji": {
                            "type": "string"
                          },
                          "quantity": {
                            "type": "integer"
                          },
                          "unitPriceCents": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message",
                    "options",
                    "cardAttemptsLeft"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "PAYMENT_DECLINED",
                        "PAYMENT_FAILED",
                        "PAYMENT_UNCONFIRMED"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string",
                      "description": "Why the issuer declined, for PAYMENT_DECLINED"
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "TRY_ANOTHER_CARD",
                          "PAY_AT_PICKUP",
                          "CANCEL"
                        ]
                      }
                    },
                    "cardAttemptsLeft": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "410": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/checkouts": {
      "post": {
        "summary": "Confirm a Cart: check prices, reserve Stock for 3 minutes",
        "tags": [
          "kiosk"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "items"
                ],
                "additionalProperties": false,
                "properties": {
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "required": [
                        "productId",
                        "quantity",
                        "unitPriceCents"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "productId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10
                        },
                        "unitPriceCents": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "The price the Customer saw"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "description": "A UUID v4, reused when repeating the same request"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "header",
            "name": "x-kiosk-id",
            "required": false
          }
        ],
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "checkoutId",
                    "status",
                    "totalCents",
                    "expiresAt",
                    "items",
                    "cardAttemptsLeft",
                    "cardAllowed",
                    "order"
                  ],
                  "properties": {
                    "checkoutId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "ACTIVE",
                        "PAYING",
                        "CONSUMED",
                        "RELEASED"
                      ]
                    },
                    "totalCents": {
                      "type": "integer"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "productId",
                          "name",
                          "emoji",
                          "quantity",
                          "unitPriceCents"
                        ],
                        "properties": {
                          "productId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          },
                          "emoji": {
                            "type": "string"
                          },
                          "quantity": {
                            "type": "integer"
                          },
                          "unitPriceCents": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "cardAttemptsLeft": {
                      "type": "integer"
                    },
                    "cardAllowed": {
                      "type": "boolean"
                    },
                    "order": {
                      "type": "object",
                      "required": [
                        "orderId",
                        "code",
                        "status",
                        "paymentMethod",
                        "totalCents",
                        "cardChargeUnconfirmed",
                        "createdAt",
                        "items"
                      ],
                      "properties": {
                        "orderId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "code": {
                          "type": "string",
                          "description": "Short code the Customer reads out at pickup, such as A-042"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "PAYMENT_PENDING",
                            "PAID",
                            "PICKED_UP",
                            "CANCELLED"
                          ]
                        },
                        "paymentMethod": {
                          "type": "string",
                          "enum": [
                            "CARD",
                            "PAY_AT_PICKUP"
                          ]
                        },
                        "totalCents": {
                          "type": "integer"
                        },
                        "cardChargeUnconfirmed": {
                          "type": "boolean",
                          "description": "A card charge for this purchase could not be confirmed and is being refunded"
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "productId",
                              "name",
                              "emoji",
                              "quantity",
                              "unitPriceCents"
                            ],
                            "properties": {
                              "productId": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "name": {
                                "type": "string"
                              },
                              "emoji": {
                                "type": "string"
                              },
                              "quantity": {
                                "type": "integer"
                              },
                              "unitPriceCents": {
                                "type": "integer"
                              }
                            }
                          }
                        }
                      },
                      "description": "The Order, once the Checkout became one",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "conflicts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "productId",
                          "name",
                          "reasons",
                          "requestedQuantity",
                          "availableQuantity",
                          "seenUnitPriceCents",
                          "currentUnitPriceCents"
                        ],
                        "properties": {
                          "productId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string",
                            "nullable": true
                          },
                          "reasons": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "SOLD_OUT",
                                "NOT_ENOUGH_STOCK",
                                "PRICE_CHANGED"
                              ]
                            }
                          },
                          "requestedQuantity": {
                            "type": "integer"
                          },
                          "availableQuantity": {
                            "type": "integer",
                            "description": "How many of the requested units can be reserved"
                          },
                          "seenUnitPriceCents": {
                            "type": "integer"
                          },
                          "currentUnitPriceCents": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
